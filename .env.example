# API 配置
# 后端 API 地址（留空则使用 mock 数据）
NEXT_PUBLIC_API_URL=

# 是否使用 mock 数据（true/false）
# 如果设置为 true 或者 NEXT_PUBLIC_API_URL 未设置，将使用 mock 数据
NEXT_PUBLIC_USE_MOCK=true

# 环境标识
NODE_ENV=development

# EdgeOne Makers 菜谱 Agent（同域部署时留空，默认请求 /recipe-chef）
# 分离部署时填写 Agent 的稳定域名及路由，例如 https://agent.example.com/recipe-chef
NEXT_PUBLIC_RECIPE_AGENT_URL=

# Makers Agents 会根据这些服务端变量声明自动签发内置模型凭据。
# 不需要在 Functions 页面手动配置，也禁止添加 NEXT_PUBLIC_ 前缀。
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash
# 只有更换为原生/自定义模型厂商时，才在 Makers 项目环境中替换上述三项。
