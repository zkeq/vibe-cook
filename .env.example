# API 配置
# 后端 API 地址（留空则使用 mock 数据）
NEXT_PUBLIC_API_URL=

# 是否使用 mock 数据（true/false）
# 如果设置为 true 或者 NEXT_PUBLIC_API_URL 未设置，将使用 mock 数据
NEXT_PUBLIC_USE_MOCK=true

# 环境标识
NODE_ENV=development

# EdgeOne Makers 菜谱 Agent（同域部署时留空，默认请求 /recipe-chef）
# 分离部署时填写 Agent 的稳定域名及路由，例如 https://agent.example.com/recipe-chef
NEXT_PUBLIC_RECIPE_AGENT_URL=

# AI 模型密钥（服务端变量，禁止添加 NEXT_PUBLIC_ 前缀）
# 填 DeepSeek 官方 API Key：在 https://platform.deepseek.com 的「API Keys」页创建。
# Agent 直接调用 DeepSeek 官方接口（https://api.deepseek.com，模型 deepseek-flash），
# 接口地址与模型名写在 agents/recipe-chef、agents/recipe-finder 的代码里，无需再配。
AI_GATEWAY_API_KEY=
RECIPE_API_BASE_URL=http://cook-api.corerevive.cn/api/v1
