{
  "name": "frontend",
  "version": "0.1.2",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:native": "vitest run --config native/vitest.config.mts",
    "native:dev": "vite --config native/vite.config.mts",
    "native:icons": "node native/scripts/icons.mjs",
    "native:build": "node native/scripts/version.mjs && vite build --config native/vite.config.mts",
    "native:preview": "vite preview --config native/vite.config.mts --host 127.0.0.1 --port 4178",
    "native:build:desktop": "npm run native:build && node native/scripts/copy-desktop.mjs",
    "desktop:dev": "node native/scripts/desktop.mjs dev",
    "desktop:build": "node native/scripts/desktop.mjs build -platform darwin/universal,windows/amd64",
    "mobile:sync": "npm run native:build && cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "android:build": "npm run native:build && cap sync android && node native/scripts/mobile.mjs android",
    "ios:build": "npm run native:build && cap sync ios && node native/scripts/mobile.mjs ios"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fancyapps/ui": "^6.1.14",
    "@mygo-plugins/fetch": "^0.2.15",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "mygo-runtime": "^0.2.15",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
